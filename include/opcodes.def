// MACRO GUARDS (no-ops by default)
#ifndef FORMAT_FIELD
#define FORMAT_FIELD(type, size, repeat_from)
#endif

#ifndef FORMAT_END
#define FORMAT_END
#endif

#ifndef BEGIN_FORMAT
#define BEGIN_FORMAT(name)
#endif

#ifndef INSTR
#define INSTR(code, name, arg_size, flags)
#endif

#ifndef VARLEN_DESCRIPTOR
#define VARLEN_DESCRIPTOR(code, name, flags, format_name, count_val)
#endif

// FULL BYTE OPCODES
// - Binary Operations (0x01 - 0x0D)
INSTR(01, BINOP_ADD, 0, 0)
INSTR(02, BINOP_SUB, 0, 0)
INSTR(03, BINOP_MUL, 0, 0)
INSTR(04, BINOP_DIV, 0, 0)
INSTR(05, BINOP_REM, 0, 0)
INSTR(06, BINOP_LT, 0, 0)
INSTR(07, BINOP_LE, 0, 0)
INSTR(08, BINOP_GT, 0, 0)
INSTR(09, BINOP_GE, 0, 0)
INSTR(0A, BINOP_EQ, 0, 0)
INSTR(0B, BINOP_NE, 0, 0)
INSTR(0C, BINOP_AND, 0, 0)
INSTR(0D, BINOP_OR, 0, 0)

// - Constants & Strings (0x10 - 0x14)
INSTR(10, const, 4, 0)
INSTR(11, xstring, 4, 0)
INSTR(12, sexp, 8, 0)
INSTR(13, sti, 4, 0)
INSTR(14, sta, 4, 0)

// - Jumps & Control (0x15 - 0x1B)
INSTR(15, jmp, 4, 0x07)
INSTR(16, end, 0, 0x06)
INSTR(17, ret, 0, 0x06)
INSTR(18, drop, 0, 0)
INSTR(19, dup, 0, 0)
INSTR(1A, swap, 0, 0)
INSTR(1B, elem, 0, 0)

// - Load Instructions (0x20 - 0x23)
INSTR(20, ld_g, 4, 0)
INSTR(21, ld_l, 4, 0)
INSTR(22, ld_a, 4, 0)
INSTR(23, ld_c, 4, 0)

// - Load Address Instructions (0x30 - 0x33)
INSTR(30, lda_g, 4, 0)
INSTR(31, lda_l, 4, 0)
INSTR(32, lda_a, 4, 0)
INSTR(33, lda_c, 4, 0)

// - Store Instructions (0x40 - 0x43)
INSTR(40, st_g, 4, 0)
INSTR(41, st_l, 4, 0)
INSTR(42, st_a, 4, 0)
INSTR(43, st_c, 4, 0)

// - Conditional Jumps (0x50 - 0x51)
INSTR(50, cjmp_z, 4, 0x05)
INSTR(51, cjmp_nz, 4, 0x05)

// - Procedure & Closure (0x52 - 0x56)
INSTR(52, begin, 8, 0)
INSTR(53, cbegin, 8, 0)

BEGIN_FORMAT(closure_format)
FORMAT_FIELD(FIELD_OP, 4, -1)
FORMAT_FIELD(FIELD_COUNT, 4, 0)
FORMAT_FIELD(FIELD_OP, 5, 0)
FORMAT_END
VARLEN_DESCRIPTOR(54, closure, 0, closure_format, 3)

INSTR(55, callc, 4, 0x04)
INSTR(56, call, 8, 0x05)

// - Other Instructions (0x57 - 0x5A)
INSTR(57, tag, 8, 0)
INSTR(58, array, 4, 0)
INSTR(59, fail, 8, 0x06)
INSTR(5A, line, 4, 0)

// - Pattern Matching (0x60 - 0x66)
INSTR(60, patt_str, 1, 0)
INSTR(61, patt_string, 1, 0)
INSTR(62, patt_array, 1, 0)
INSTR(63, patt_sexp, 1, 0)
INSTR(64, patt_ref, 1, 0)
INSTR(65, patt_val, 1, 0)
INSTR(66, patt_fun, 1, 0)

// - Built-in Calls (0x70 - 0x74)
INSTR(70, call_read, 0, 0x04)
INSTR(71, call_write, 0, 0x04)
INSTR(72, call_length, 0, 0x04)
INSTR(73, call_string, 0, 0x04)
INSTR(74, call_array, 4, 0x04)
